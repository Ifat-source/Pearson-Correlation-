# 14. SAFE PEARSON CORRELATION FUNCTION
# =====================================================================

def calculate_pearson_matrix(data, variables):

    missing = [
        v for v in variables
        if v not in data.columns
    ]

    if missing:

        raise ValueError(
            f"Missing variables: {missing}"
        )

    if data.columns.duplicated().any():

        duplicates = data.columns[
            data.columns.duplicated()
        ].tolist()

        raise ValueError(
            f"Duplicate columns: {duplicates}"
        )

    correlation_matrix = pd.DataFrame(
        np.nan,
        index=variables,
        columns=variables,
        dtype=float
    )

    pvalue_matrix = pd.DataFrame(
        np.nan,
        index=variables,
        columns=variables,
        dtype=float
    )

    sample_matrix = pd.DataFrame(
        0,
        index=variables,
        columns=variables,
        dtype=int
    )

    for var1 in variables:

        for var2 in variables:

            x = pd.to_numeric(
                data[var1],
                errors="coerce"
            )

            y = pd.to_numeric(
                data[var2],
                errors="coerce"
            )

            if isinstance(x, pd.DataFrame):
                raise ValueError(
                    f"{var1} returned multiple columns."
                )

            if isinstance(y, pd.DataFrame):
                raise ValueError(
                    f"{var2} returned multiple columns."
                )

            pair = pd.DataFrame({
                "x": x,
                "y": y
            })

            pair = pair.replace(
                [np.inf, -np.inf],
                np.nan
            ).dropna()

            n = int(len(pair))

            sample_matrix.loc[var1, var2] = n

            if n < 3:
                continue

            x_values = pair["x"].to_numpy(
                dtype=np.float64
            )

            y_values = pair["y"].to_numpy(
                dtype=np.float64
            )

            if (
                np.std(x_values) == 0
                or np.std(y_values) == 0
            ):
                continue

            r, p = pearsonr(
                x_values,
                y_values
            )

            r = float(np.asarray(r).item())

            p = float(np.asarray(p).item())

            correlation_matrix.loc[var1, var2] = r

            pvalue_matrix.loc[var1, var2] = p

    return (
        correlation_matrix,
        pvalue_matrix,
        sample_matrix
    )


