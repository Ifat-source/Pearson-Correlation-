# =====================================================================
# 8. IDENTIFY EXCEL COLUMNS
# =====================================================================

def find_column(df, canonical_name, file_name):

    aliases = COLUMN_ALIASES[canonical_name]

    normalized_aliases = {
        normalize_column_name(x) for x in aliases
    }

    matches = []

    for col in df.columns:

        normalized = normalize_column_name(col)

        if normalized in normalized_aliases:
            matches.append(col)

    if not matches:

        for col in df.columns:

            normalized = normalize_column_name(col)

            if canonical_name == "Date":

                if normalized in ["date", "datetime", "time"]:
                    matches.append(col)

            elif canonical_name == "Water Level (m)":

                if (
                    "waterlevel" in normalized
                    or normalized in ["wl", "wlm", "stage"]
                ):
                    matches.append(col)

            elif canonical_name == "Precipitation (m)":

                if (
                    "precip" in normalized
                    or "rainfall" in normalized
                ):
                    matches.append(col)

            elif canonical_name == "Mean Temperature (K)":

                if (
                    "temperature" in normalized
                    or "meantemp" in normalized
                    or normalized == "temp"
                ):
                    matches.append(col)

            elif canonical_name == "Soil Moisture (m)":

                if (
                    "soilmoisture" in normalized
                    or "soilwatercontent" in normalized
                ):
                    matches.append(col)

            elif canonical_name == "Runoff Depth (m)":

                if "runoff" in normalized:
                    matches.append(col)

    matches = list(dict.fromkeys(matches))

    if len(matches) == 0:

        raise ValueError(
            f"\nCannot identify column: {canonical_name}"
            f"\nFile: {file_name}"
            f"\nActual Excel columns: {df.columns.tolist()}"
        )

    if len(matches) > 1:

        reference = df[matches[0]]

        for other_col in matches[1:]:

            if not reference.equals(df[other_col]):

                raise ValueError(
                    f"\nConflicting duplicate columns detected."
                    f"\nFile: {file_name}"
                    f"\nVariable: {canonical_name}"
                    f"\nColumns: {matches}"
                )

        print(
            f"Identical duplicate columns found for "
            f"{canonical_name}: {matches}. "
            f"Using {matches[0]}."
        )

    return matches[0]


# =====================================================================
# 9. DETECT PRECIPITATION UNIT
# =====================================================================

def detect_precipitation_unit(column_name):

    normalized = normalize_column_name(column_name)

    if "mm" in normalized:
        return "mm"

    if "cm" in normalized:
        return "cm"

    if normalized.endswith("m"):
        return "m"

    return PRECIPITATION_UNIT_WITHOUT_LABEL.lower()


# =====================================================================
# 10. EXTRACT SHORT STATION ID
# =====================================================================

def extract_station_id(station_name):

    """
    Examples:

    1. SW_45.5_Chilmari complete
       -> SW 45.5

    SW_46.0
       -> SW 46.0

    5. SW_47.5_station
       -> SW 47.5
    """

    # Find alphabetic station prefix followed by a number.
    match = re.search(
        r"([A-Za-z]{1,8})[_\s-]*(\d+(?:\.\d+)?)",
        station_name
    )

    if match:

        prefix = match.group(1).upper()

        number = match.group(2)

        return f"{prefix} {number}"

    # Fallback: remove leading numbering and clean the name.
    cleaned = re.sub(
        r"^\s*\d+\s*[\.\-_]?\s*",
        "",
        station_name
    )

    cleaned = re.sub(
        r"\bcomplete\b",
        "",
        cleaned,
        flags=re.IGNORECASE
    )

    cleaned = cleaned.replace("_", " ").strip()

    return cleaned


