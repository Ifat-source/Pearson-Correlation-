def standardize_station_data(file_path):

    print(f"\nReading: {file_path.name}")

    df = pd.read_excel(file_path)

    if df.empty:
        raise ValueError(
            f"Empty Excel file: {file_path.name}"
        )

    df = df.dropna(axis=1, how="all")

    column_mapping = {}

    for canonical in ["Date"] + VARIABLES:

        actual_column = find_column(
            df,
            canonical,
            file_path.name
        )

        column_mapping[canonical] = actual_column

    selected = pd.DataFrame()

    for canonical, actual in column_mapping.items():

        selected[canonical] = df[actual].copy()

    selected["Date"] = pd.to_datetime(
        selected["Date"],
        errors="coerce"
    )

    selected = selected.dropna(
        subset=["Date"]
    )

    selected = selected[
        (selected["Date"] >= pd.Timestamp(START_DATE))
        &
        (selected["Date"] < pd.Timestamp(END_DATE))
    ].copy()

    for variable in VARIABLES:

        selected[variable] = pd.to_numeric(
            selected[variable],
            errors="coerce"
        )

    # Precipitation unit conversion
    original_precip_column = column_mapping[
        "Precipitation (m)"
    ]

    precip_unit = detect_precipitation_unit(
        original_precip_column
    )

    if precip_unit == "mm":

        selected["Precipitation (m)"] /= 1000

    elif precip_unit == "cm":

        selected["Precipitation (m)"] /= 100

    elif precip_unit != "m":

        raise ValueError(
            f"Unsupported precipitation unit: {precip_unit}"
        )

    selected[VARIABLES] = selected[VARIABLES].replace(
        [np.inf, -np.inf],
        np.nan
    )

    selected = selected.sort_values("Date")

    duplicate_dates = selected["Date"].duplicated().sum()

    if duplicate_dates > 0:

        print(
            f"WARNING: {duplicate_dates} duplicate dates "
            f"found in {file_path.name}. Keeping first."
        )

        selected = selected.drop_duplicates(
            subset="Date",
            keep="first"
        )

    selected = selected.reset_index(drop=True)

    station_name = file_path.stem

    station_id = extract_station_id(station_name)

    selected["Station"] = station_name

    selected["Station_ID"] = station_id

    mapping_record = {
        "Station": station_name,
        "Station_ID": station_id,
        "File": file_path.name,
        "Precipitation original heading": original_precip_column,
        "Detected precipitation unit": precip_unit
    }

    for canonical, actual in column_mapping.items():

        mapping_record[
            f"Original heading: {canonical}"
        ] = str(actual)

    print("Station:", station_name)
    print("Station ID:", station_id)
    print("Valid observations:", len(selected))

    return selected, mapping_record


