def normalize_column_name(name):

    name = str(name)

    name = unicodedata.normalize("NFKC", name)

    name = name.replace("\ufeff", "")
    name = name.replace("\u200b", "")

    name = name.strip().lower()

    name = re.sub(r"\.\d+$", "", name)

    name = re.sub(r"[^a-z0-9]", "", name)

    return name


