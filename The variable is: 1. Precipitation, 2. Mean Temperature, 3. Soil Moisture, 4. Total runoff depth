def save_general_heatmap(
    matrix,
    title,
    output_name,
    output_folder
):

    plt.figure(figsize=(11, 9))

    ax = sns.heatmap(
        matrix,
        annot=True,
        fmt=".2f",
        cmap="RdBu_r",
        vmin=-1,
        vmax=1,
        center=0,
        square=True,
        linewidths=0.5,
        linecolor="white",
        annot_kws={
            "size": GENERAL_ANNOT_FONT
        },
        cbar_kws={
            "label": "Pearson correlation coefficient (r)"
        }
    )

    ax.set_title(
        title,
        fontsize=15,
        fontweight="bold",
        pad=15
    )

    ax.tick_params(
        axis="x",
        labelsize=GENERAL_TICK_FONT,
        rotation=45
    )

    ax.tick_params(
        axis="y",
        labelsize=GENERAL_TICK_FONT,
        rotation=0
    )

    plt.tight_layout()

    plt.savefig(
        output_folder / f"{output_name}.png",
        dpi=DPI,
        bbox_inches="tight"
    )

    if SAVE_TIFF:

        plt.savefig(
            output_folder / f"{output_name}.tiff",
            dpi=DPI,
            bbox_inches="tight"
        )

    plt.close()


# =====================================================================
# 16. PUBLICATION-STYLE SUMMARY HEATMAP FUNCTION
# =====================================================================

def save_summary_heatmap(
    matrix,
    output_name,
    output_folder,
    figure_size,
    x_font,
    y_font,
    annotation_font,
    x_rotation=0
):

    """
    Publication-style heatmap:

    - No plot title
    - No x-axis heading
    - No y-axis heading
    - Station IDs only on y-axis
    - Short variable labels on x-axis
    - Large, readable annotations
    """

    fig, ax = plt.subplots(
        figsize=figure_size
    )

    sns.heatmap(
        matrix,
        ax=ax,
        annot=True,
        fmt=".2f",
        cmap="RdBu_r",
        vmin=-1,
        vmax=1,
        center=0,
        linewidths=0.6,
        linecolor="white",
        square=False,
        annot_kws={
            "size": annotation_font,
            "weight": "medium"
        },
        cbar_kws={
            "label": "Pearson correlation coefficient (r)",
            "shrink": 0.85,
            "pad": 0.03
        }
    )

    # Remove plot heading
    ax.set_title("")

    # Remove axis headings
    ax.set_xlabel("")
    ax.set_ylabel("")

    # Short x-axis labels
    ax.set_xticklabels(
        matrix.columns,
        rotation=x_rotation,
        ha="center" if x_rotation == 0 else "right",
        fontsize=x_font,
        fontweight="medium"
    )

    # Station IDs only on y-axis
    ax.set_yticklabels(
        matrix.index,
        rotation=0,
        fontsize=y_font,
        fontweight="medium"
    )

    ax.tick_params(
        axis="both",
        which="both",
        length=0,
        pad=7
    )

    # Colorbar font
    colorbar = ax.collections[0].colorbar

    colorbar.ax.tick_params(
        labelsize=11
    )

    colorbar.set_label(
        "Pearson correlation coefficient (r)",
        fontsize=12
    )

    # No surrounding top/right borders
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)

    plt.tight_layout(
        pad=1.2
    )

    # Save PNG
    png_path = output_folder / f"{output_name}.png"

    fig.savefig(
        png_path,
        dpi=DPI,
        bbox_inches="tight",
        facecolor="white"
    )

    # Save TIFF
    if SAVE_TIFF:

        tiff_path = output_folder / f"{output_name}.tiff"

        fig.savefig(
            tiff_path,
            dpi=DPI,
            bbox_inches="tight",
            facecolor="white"
        )

    plt.close(fig)

    print("Saved:", png_path)


